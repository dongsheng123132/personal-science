{
  "classics": {
    "enabled": true,
    "path": "collector/classics.json"
  },
  "wikipedia": {
    "enabled": true,
    "sites": ["zh.wikipedia.org", "en.wikipedia.org"],
    "queries": [
      "经典实验 物理",
      "思想实验",
      "物理学史 实验",
      "科学史 实验",
      "classic experiment",
      "thought experiment",
      "history of science experiment"
    ],
    "limit": 6
  },
  "wordpress": {
    "enabled": true,
    "sites": ["https://hackaday.com"],
    "queries": [
      "spectrometer",
      "microscope",
      "telescope",
      "geiger counter",
      "air quality",
      "water quality",
      "calibration",
      "sensor",
      "DIY lab",
      "weather station",
      "oscilloscope"
    ],
    "per_query": 5
  },
  "feeds": {
    "enabled": true,
    "feeds": [
      { "name": "hackaday", "url": "https://hackaday.com/tag/science/feed/", "enabled": true },
      { "name": "hackaday", "url": "https://hackaday.com/tag/measurement/feed/", "enabled": true },
      { "name": "hackaday", "url": "https://hackaday.com/tag/sensors/feed/", "enabled": true },
      { "name": "hackaday", "url": "https://hackaday.com/tag/test-equipment/feed/", "enabled": true },
      { "name": "hackaday", "url": "https://hackaday.com/tag/metrology/feed/", "enabled": true },
      { "name": "hackaday", "url": "https://hackaday.com/tag/microscope/feed/", "enabled": true },
      { "name": "hackaday", "url": "https://hackaday.com/tag/spectroscopy/feed/", "enabled": true },
      { "name": "hackaday", "url": "https://hackaday.com/tag/radiation/feed/", "enabled": true },
      { "name": "hackaday", "url": "https://hackaday.com/tag/weather/feed/", "enabled": true },
      { "name": "hackaday", "url": "https://hackaday.com/tag/citizen-science/feed/", "enabled": true }
    ]
  },
  "hn": {
    "enabled": true,
    "queries": ["citizen science", "DIY science", "home lab", "self experiment"],
    "days": 90
  },
  "github": {
    "enabled": false,
    "queries": ["topic:citizen-science"],
    "per_query": 6
  },
  "arxiv": {
    "enabled": false,
    "queries": ["citizen science"],
    "max_results": 6
  }
}
