{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gitscience.dev/schema/exp.schema.json",
  "title": "GitScience Experiment",
  "type": "object",
  "required": ["gitscience", "kind", "id", "title", "author", "status", "question", "protocol"],
  "properties": {
    "gitscience": { "type": "string", "enum": ["0.1"] },
    "kind": { "const": "experiment" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 4, "maxLength": 120 },
    "author": { "type": "string", "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,38})$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "field": { "type": "array", "items": { "type": "string" } },
    "status": { "type": "string", "enum": ["planned", "running", "done", "blocked"] },
    "question": { "type": "string", "minLength": 8, "maxLength": 500 },
    "hypothesis": { "type": "string", "maxLength": 500 },
    "protocol": {
      "type": "object",
      "required": ["acceptance"],
      "properties": {
        "samples": { "type": "integer", "minimum": 1 },
        "repeats": { "type": "integer", "minimum": 1 },
        "gear": { "type": "array", "items": { "type": "string" } },
        "steps": { "type": "array", "items": { "type": "string" } },
        "acceptance": { "type": "string", "minLength": 4 },
        "limits": { "type": "array", "items": { "type": "string" } }
      }
    },
    "result": {
      "type": "object",
      "properties": {
        "outcome": { "type": "string", "enum": ["supports", "refutes", "inconclusive"] },
        "summary": { "type": "string", "maxLength": 1000 },
        "measurements": { "type": "array", "items": { "type": "object" } },
        "files": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
